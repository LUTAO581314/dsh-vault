+    // ===== host 兼容层（DSH Desktop 2.0.18 / @deepseek-ai/dsh-subagent 0.2.1-rc.2）=====
+    // 该宿主的 subagent 服务只暴露 startActivation(spec)，没有旧的 startContinuable(spec) 与
+    // start(provider, request)。类型上 SubagentActivation 与 SubagentRun 同构
+    // （{ childId | id, result: Promise<SubagentResult>, dispose() }），因此适配只是剥壳：
+    //   · worker（continuable）→ 只要 { childId, messageId }：board 用 childId 定位 agent/status 事件与续跑
+    //   · verifier / hook（one-shot）→ 需要 { id, result, dispose }：run.result 结算通道逐字复用
+    // delivery:'parent' 对应旧 start/startContinuable 的结果投递归属（子结果回到派发者会话）。
+    // 旧宿主/旧测试桩仍先走原生方法（存在即优先），行为不变。
+    async function startActivationCompat(subagents, providerName, label, request, signal) {
+      var a = await subagents.startActivation({ provider: providerName, label: label, request: request, signal: signal, delivery: 'parent' })
+      if (!a || !a.childId) throw new Error('startActivation 未返回 childId')
+      return a
+    }
+    async function startContinuableCompat(subagents, spec) {
+      if (typeof subagents.startContinuable === 'function') return subagents.startContinuable(spec)
+      var a = await startActivationCompat(subagents, spec.provider, spec.label, spec.request, spec.signal)
+      return { childId: String(a.childId), messageId: a.messageId }
+    }
+    async function startOneShotCompat(subagents, providerName, req) {
+      if (typeof subagents.start === 'function') return subagents.start(providerName, req)
+      var a = await startActivationCompat(subagents, providerName, req.label || 'subagent', req, req.signal)
+      return { id: String(a.childId), result: a.result, dispose: function () { return a.dispose() } }
+    }
